---
import { HISTORIA } from "../data/diezell";
---

<section id="historia" class="border-y border-outline-variant" aria-labelledby="titulo-historia">
  <div class="m3-container py-24 md:py-36">
    <div class="reveal">
      <p class="m3-label-large text-primary">06 — Historia</p>
      <h2 id="titulo-historia" class="m3-display-medium mt-4 text-on-surface">2015 — 2026</h2>
    </div>
    <ol class="mt-12">
      {HISTORIA.map((h) => (
        <li class="reveal grid gap-2 border-t border-outline-variant py-8 md:grid-cols-12 md:gap-6">
          <span class="m3-display-small text-on-surface-variant md:col-span-3">{h.anio}</span>
          <div class="md:col-span-9">
            <p class="m3-body-large max-w-2xl text-on-surface-variant">{h.texto}</p>
            <p class="m3-body-small mt-3 text-on-surface-variant">
              Fuente: {h.fuentes.map((f, i) => (
                <span>
                  {i > 0 && " · "}
                  <a href={f.url} target="_blank" rel="noopener" class="text-primary underline underline-offset-4">{f.medio}{f.fecha ? `, ${f.fecha}` : ""} ↗</a>
                </span>
              ))}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
