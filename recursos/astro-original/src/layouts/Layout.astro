---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "DIEZELL — INSANIA · Web de fans",
  description = "Diezell, banda de Monterrey. INSANIA (2025) y Caótico (2023), letras, historia e Insania Tour 2026. Web de fans, no oficial.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0a0a0a" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-surface text-on-surface">
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />

    <script>
      // Reveal M3: fade + slide corto con easing enfatizado
      const revealEls = document.querySelectorAll(".reveal");
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-visible");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12 }
      );
      revealEls.forEach((el) => io.observe(el));

      // INSANIA -> VINVSNI: gira 180° cuando el hero sale del viewport
      const flip = document.querySelector<HTMLElement>("[data-flip]");
      const hero = document.querySelector<HTMLElement>("[data-hero]");
      if (flip && hero) {
        const flipIo = new IntersectionObserver(
          ([entry]) => flip.classList.toggle("is-flipped", !entry.isIntersecting),
          { threshold: 0.35 }
        );
        flipIo.observe(hero);
        flip.addEventListener("click", () => flip.classList.toggle("is-flipped"));
      }

      // Navigation Bar M3: indicador activo al tocar una destino
      const navLinks = document.querySelectorAll<HTMLElement>(".m3-nav-bar a");
      navLinks.forEach((a) => {
        a.addEventListener("click", () => {
          navLinks.forEach((l) => l.removeAttribute("aria-current"));
          a.setAttribute("aria-current", "page");
        });
      });
    </script>
  </body>
</html>
